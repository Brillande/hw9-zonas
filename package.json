{
  "name": "hw9-zonas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frecuencia cardiaca, zonas y rutinas con la banda COOSPO HW9",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "android:sync": "vite build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:open": "cap open android",
    "postinstall": "node scripts/patch-ble.mjs",
    "deploy": "vite build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@cloudflare/vite-plugin": "^1.63.1",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
